# Copy this file to .env and fill in your API keys.
# .env is gitignored — never commit real secrets.

# OpenAI — used by Whisper transcription and GPT script generation
OPENAI_API_KEY=

# ElevenLabs — voiceover synthesis
ELEVENLABS_API_KEY=

# Pexels — stock B-roll search and download
PEXELS_API_KEY=

# Kie.ai — AI image-to-video generation
KIE_AI_API_KEY=
KIE_AI_BASE_URL=https://api.kie.ai/api/v1
GENERATOR_MODEL=grok-imagine/image-to-video

# Google AI — image generation
GOOGLE_API_KEY=
